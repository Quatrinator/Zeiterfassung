APP_URL=https://zeit.example.de
APP_NAME=Zeitwerk
COMPANY_NAME=Externe Firma
TRUSTED_PROXIES=127.0.0.1/32
# Only bind to localhost by default. For a remote proxy use a private host IP
# and restrict access to that proxy in the host firewall.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_ENV=production
COOKIE_SECURE=1
